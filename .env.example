# Build-time configuration (all optional). NEXT_PUBLIC_* values are embedded in the static files.
# The app is client-side only; these two optional build-time values are the whole configuration.

# Public site URL used for canonical links, Open Graph, the sitemap and robots.txt.
# On Vercel this is derived automatically from VERCEL_PROJECT_PRODUCTION_URL; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://ledgerlocal.example.com

# Hosting under a sub-path, e.g. GitHub Pages project sites (https://user.github.io/ledgerlocal):
# NEXT_PUBLIC_BASE_PATH=/ledgerlocal
