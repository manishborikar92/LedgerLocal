# Optional configuration. NEXT_PUBLIC_* values are inlined into the build, so set them BEFORE `npm run build`.
# Copy to .env.local for local development; on a host, set them in its environment-variable settings. Nothing else is configurable.

# Public site URL used for canonical links, Open Graph, the sitemap and robots.txt.
# On Vercel it is derived automatically from VERCEL_PROJECT_PRODUCTION_URL; set it for a custom domain or any other host.
# NEXT_PUBLIC_SITE_URL=https://ledgerlocal.example.com

# Serve the app under a sub-path (e.g. https://example.com/ledgerlocal).
# NEXT_PUBLIC_BASE_PATH=/ledgerlocal
